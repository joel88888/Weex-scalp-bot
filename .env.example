# Copy this file to .env and fill in only what you need.
#   cp .env.example .env
# Never commit .env. Keys belong only on your machine.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo     = default. Uses WEEX paper trading at /capi/v3/sim/ (SUSDT).
#            Needs API keys. If keys are missing, the bot falls back to dry_run.
# dry_run  = public WebSocket only. Simulates taker fills locally. No orders.
# live     = real futures orders. Refused unless BOTH flags below are true.
MODE=demo
LIVE=false
I_UNDERSTAND_LIVE=false

# ---------------------------------------------------------------------------
# WEEX API keys  (Account → API Management)
# Read + Futures only. NO withdraw. Alphanumeric passphrase.
# New keys take ~15 minutes to work. Bind an IP whitelist before going live.
# ---------------------------------------------------------------------------
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Market / size  (leverage is hard-capped at 1x in code)
# ---------------------------------------------------------------------------
SYMBOL=BTCUSDT
# Official demo Place Order docs use BTCSUSDT (SUSDT paper market).
DEMO_SYMBOL=BTCSUSDT
QUANTITY=0.001
MAX_POSITION_QTY=0.001
MAX_NOTIONAL_USDT=80

# Take-profit / stop-loss are percent of entry (0.12 = 0.12%).
TAKE_PROFIT_PCT=0.12
STOP_LOSS_PCT=0.10
MAX_DAILY_LOSS_USDT=15

# Strategy: mid vs last N seconds. Enter only if spread is tight.
WINDOW_SECONDS=15
ENTRY_DEVIATION_BPS=6
MAX_SPREAD_BPS=4
COOLDOWN_AFTER_STOP_SECONDS=90

# Conservative taker assumption. Replace with your account rate if you know it.
TAKER_FEE_RATE=0.0006

# Well under WEEX futures 300 orders/min.
MAX_ORDERS_PER_MINUTE=8

# Logs (Europe/London timestamps in trades.csv)
TIMEZONE=Europe/London
LOG_DIR=logs
STATUS_EVERY_SECONDS=5

# 0 = run until Ctrl+C. Set e.g. 30 for a short smoke test.
DURATION_SECONDS=0
